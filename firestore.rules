    }

    function isValidConversation(data, conversationId) {
      return data.keys().hasAll([
          'id', 'participant1Id', 'participant2Id',
          'participant1Name', 'participant2Name',
          'lastMessage', 'lastMessageAt', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'participant1Id', 'participant2Id',
          'participant1Name', 'participant2Name',
          'participant1Photo', 'participant2Photo',
          'lastMessage', 'lastMessageAt', 'createdAt', 'updatedAt'
        ]) &&
        data.id == conversationId &&
        isValidId(data.id) &&
        isValidId(data.participant1Id) &&
        isValidId(data.participant2Id) &&
        data.participant1Id != data.participant2Id &&
        data.participant1Name is string && data.participant1Name.size() >= 1 && data.participant1Name.size() <= 80 &&
        data.participant2Name is string && data.participant2Name.size() >= 1 && data.participant2Name.size() <= 80 &&
        isOptionalSafeMediaUrl(data, 'participant1Photo', 350000) &&
        isOptionalSafeMediaUrl(data, 'participant2Photo', 350000) &&
        data.lastMessage is string && data.lastMessage.size() <= 300 &&
        data.lastMessageAt is timestamp &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPrivateMessage(data, conversationId, messageId) {
      return data.keys().hasAll([
          'id', 'conversationId', 'participant1Id', 'participant2Id',
          'senderId', 'senderName', 'text', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'conversationId', 'participant1Id', 'participant2Id',
          'senderId', 'senderName', 'text', 'bookingId', 'createdAt'
        ]) &&
        data.id == messageId &&
        data.conversationId == conversationId &&
