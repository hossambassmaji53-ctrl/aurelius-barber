        data.action is string && data.action.size() >= 1 && data.action.size() <= 100 &&
        isValidId(data.targetUserId) &&
        data.targetUserName is string && data.targetUserName.size() >= 1 && data.targetUserName.size() <= 80 &&
        isOptionalString(data, 'reason', 300) &&
