    function isValidBooking(data, bookingId) {
      return data.keys().hasAll([
          'id', 'conversationId', 'customerId', 'customerName',
          'barberId', 'barberName', 'serviceId', 'serviceName',
          'servicePrice', 'serviceDuration', 'date', 'time',
          'status', 'reviewed', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'conversationId', 'customerId', 'customerName', 'customerPhoto',
          'barberId', 'barberName', 'barberPhoto', 'serviceId', 'serviceName',
          'servicePrice', 'serviceDuration', 'date', 'time', 'notes',
          'status', 'reviewed', 'createdAt', 'updatedAt'
        ]) &&
        data.id == bookingId &&
        isValidId(data.id) &&
        isValidId(data.conversationId) &&
        isValidId(data.customerId) &&
        isValidId(data.barberId) &&
        data.customerId != data.barberId &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 80 &&
        isOptionalSafeMediaUrl(data, 'customerPhoto', 350000) &&
        data.barberName is string && data.barberName.size() >= 1 && data.barberName.size() <= 80 &&
        isOptionalSafeMediaUrl(data, 'barberPhoto', 350000) &&
        data.serviceId is string && data.serviceId.size() >= 1 && data.serviceId.size() <= 128 &&
        data.serviceName is string && data.serviceName.size() >= 1 && data.serviceName.size() <= 100 &&
        data.servicePrice is number && data.servicePrice >= 0 && data.servicePrice <= 100000 &&
        data.serviceDuration is number && data.serviceDuration >= 5 && data.serviceDuration <= 480 &&
        data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        data.time is string && data.time.matches('^\\d{2}:\\d{2}$') &&
        isOptionalString(data, 'notes', 400) &&
        data.status in ['pending', 'confirmed', 'rescheduled', 'rejected', 'completed', 'cancelled'] &&
        data.reviewed is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidReview(data, reviewId) {
      return data.keys().hasAll([
          'id', 'bookingId', 'barberId', 'customerId', 'customerName',
          'rating', 'comment', 'visibility', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'bookingId', 'barberId', 'customerId', 'customerName',
          'customerPhoto', 'rating', 'comment', 'visibility', 'createdAt'
        ]) &&
        data.id == reviewId &&
        isValidId(data.id) &&
        isValidId(data.bookingId) &&
        isValidId(data.barberId) &&
        isValidId(data.customerId) &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 80 &&
        isOptionalSafeMediaUrl(data, 'customerPhoto', 350000) &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.comment is string && data.comment.size() >= 1 && data.comment.size() <= 500 &&
        data.visibility == 'public' &&
        data.createdAt is timestamp;
    }

    function isValidNotification(data, notificationId) {
      return data.keys().hasAll([
          'id', 'recipientId', 'senderId', 'senderName', 'type',
          'title', 'body', 'targetView', 'targetId', 'read', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'recipientId', 'senderId', 'senderName', 'type',
          'title', 'body', 'targetView', 'targetId', 'read', 'createdAt'
        ]) &&
        data.id == notificationId &&
        isValidId(data.id) &&
        isValidId(data.recipientId) &&
        isValidId(data.senderId) &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
        data.type in [
          'message', 'booking_new', 'booking_update', 'role_update', 'moderation',
          'verification_request', 'ticket_new', 'ticket_update', 'announcement',
          'story_reaction', 'story_reply', 'friend_request', 'friend_accept',
          'credit_grant', 'store_purchase'
        ] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.body is string && data.body.size() >= 1 && data.body.size() <= 300 &&
        data.targetView in [
          'private_chat', 'appointments', 'community', 'profile', 'admin',
          'tickets', 'staff_room', 'season', 'leaderboard', 'about', 'stories', 'store'
        ] &&
        data.targetId is string && data.targetId.size() <= 128 &&
        data.read is bool &&
        data.createdAt is timestamp;
    }

    function isValidActivityLog(data, logId) {
      return data.keys().hasAll([
          'id', 'actorId', 'actorName', 'action',
