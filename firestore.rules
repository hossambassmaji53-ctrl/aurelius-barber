          'id', 'seasonKey', 'galleryItemId', 'barberId', 'voterId', 'createdAt', 'updatedAt'
        ]) &&
        data.id == voteId &&
        isValidId(data.id) &&
        data.seasonKey is string && data.seasonKey.matches('^[a-zA-Z0-9_\\-]{2,40}$') &&
        isValidId(data.galleryItemId) &&
        isValidId(data.barberId) &&
        isValidId(data.voterId) &&
