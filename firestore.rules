          'galleryItemId', 'galleryItemTitle', 'galleryItemImageUrl',
          'votesCount', 'awardedById', 'createdAt', 'updatedAt'
        ]) &&
        data.id == awardId &&
        data.seasonKey == awardId &&
        data.seasonKey is string && data.seasonKey.matches('^[a-zA-Z0-9_\\-]{2,40}$') &&
        data.seasonLabel is string && data.seasonLabel.size() >= 1 && data.seasonLabel.size() <= 80 &&
        isValidId(data.barberId) &&
        data.barberName is string && data.barberName.size() >= 1 && data.barberName.size() <= 80 &&
        isOptionalSafeMediaUrl(data, 'barberPhoto', 350000) &&
        isValidId(data.galleryItemId) &&
        data.galleryItemTitle is string && data.galleryItemTitle.size() >= 1 && data.galleryItemTitle.size() <= 100 &&
        isSafeMediaUrlString(data.galleryItemImageUrl, 400000) &&
        data.galleryItemImageUrl.size() >= 1 &&
        data.votesCount is int && data.votesCount >= 0 && data.votesCount <= 1000000 &&
        isValidId(data.awardedById) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSeasonConfig(data, configId) {
      return data.keys().hasAll([
          'id', 'isHidden', 'isVotingOpen', 'activeSeasonKey',
          'activeSeasonLabel', 'updatedById', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'isHidden', 'isVotingOpen', 'activeSeasonKey',
          'activeSeasonLabel', 'contestHeadline', 'contestSubtitle',
          'updatedById', 'createdAt', 'updatedAt'
        ]) &&
        data.id == configId &&
        configId == 'current' &&
        data.isHidden is bool &&
        data.isVotingOpen is bool &&
        data.activeSeasonKey is string && data.activeSeasonKey.matches('^[a-zA-Z0-9_\\-]{2,40}$') &&
        data.activeSeasonLabel is string && data.activeSeasonLabel.size() >= 1 && data.activeSeasonLabel.size() <= 80 &&
        isOptionalString(data, 'contestHeadline', 140) &&
        isOptionalString(data, 'contestSubtitle', 500) &&
        isValidId(data.updatedById) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isSeasonVotingActive(targetSeasonKey) {
      return exists(/databases/$(database)/documents/seasonConfig/current) &&
        get(/databases/$(database)/documents/seasonConfig/current).data.isHidden == false &&
        get(/databases/$(database)/documents/seasonConfig/current).data.isVotingOpen == true &&
        get(/databases/$(database)/documents/seasonConfig/current).data.activeSeasonKey == targetSeasonKey;
    }

    function isValidBarberStory(data, storyId) {
      return data.keys().hasAll([
          'id', 'barberId', 'barberName', 'mediaType', 'mediaUrl',
          'visibility', 'expiresAt', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'barberId', 'barberName', 'barberPhoto', 'salonName',
          'mediaType', 'mediaUrl', 'beforeMediaUrl', 'caption',
          'countryCode', 'visibility', 'expiresAt', 'createdAt'
        ]) &&
        data.id == storyId &&
        isValidId(data.id) &&
        isValidId(data.barberId) &&
        data.barberName is string && data.barberName.size() >= 1 && data.barberName.size() <= 80 &&
        isOptionalSafeMediaUrl(data, 'barberPhoto', 350000) &&
        isOptionalString(data, 'salonName', 100) &&
        data.mediaType in ['image', 'before_after', 'video'] &&
        isSafeStoryMediaUrlString(data.mediaUrl, 750000) &&
        data.mediaUrl.size() >= 1 &&
        isOptionalSafeMediaUrl(data, 'beforeMediaUrl', 360000) &&
        isOptionalString(data, 'caption', 200) &&
        isOptionalCountryCode(data) &&
        data.visibility == 'public' &&
        data.expiresAt is timestamp &&
        data.createdAt is timestamp;
    }

    function isValidStoryReaction(data, reactionId) {
      return data.keys().hasAll([
          'id', 'storyId', 'storyAuthorId', 'userId', 'userName',
          'reaction', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'storyId', 'storyAuthorId', 'userId', 'userName',
          'userPhoto', 'reaction', 'emojiKey', 'createdAt', 'updatedAt'
        ]) &&
        data.id == reactionId &&
        isValidId(data.id) &&
        isValidId(data.storyId) &&
        isValidId(data.storyAuthorId) &&
        isValidId(data.userId) &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
        isOptionalSafeMediaUrl(data, 'userPhoto', 350000) &&
data.reaction is string && data.reaction.size() >= 1 && data.reaction.size() <= 32 &&
        (!('emojiKey' in data) || (data.emojiKey is string && data.emojiKey.matches('^[a-z0-9_]{1,64}$'))) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPlatformAnnouncement(data, announcementId) {
      return data.keys().hasAll([
          'id', 'authorId', 'authorName', 'title', 'summary',
          'badge', 'isPinned', 'visibility', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'authorId', 'authorName', 'title', 'summary',
          'badge', 'targetWindow', 'isPinned', 'visibility', 'createdAt', 'updatedAt'
        ]) &&
        data.id == announcementId &&
        isValidId(data.id) &&
        isValidId(data.authorId) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 1200 &&
        data.badge in ['coming_soon', 'in_development', 'major_update', 'new_feature'] &&
        isOptionalString(data, 'targetWindow', 60) &&
        data.isPinned is bool &&
        data.visibility == 'public' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidFriendship(data, friendshipId) {
      return data.keys().hasAll([
          'id', 'user1Id', 'user2Id', 'requesterId', 'recipientId',
          'requesterName', 'recipientName', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'user1Id', 'user2Id', 'requesterId', 'recipientId',
          'requesterName', 'requesterPhoto', 'recipientName', 'recipientPhoto',
          'status', 'createdAt', 'updatedAt'
        ]) &&
        data.id == friendshipId &&
        isValidId(data.id) &&
        isValidId(data.user1Id) &&
        isValidId(data.user2Id) &&
        data.user1Id < data.user2Id &&
        friendshipId == (data.user1Id + '_' + data.user2Id) &&
        isValidId(data.requesterId) &&
        isValidId(data.recipientId) &&
        data.requesterId != data.recipientId &&
        (
          (data.requesterId == data.user1Id && data.recipientId == data.user2Id) ||
          (data.requesterId == data.user2Id && data.recipientId == data.user1Id)
        ) &&
        data.requesterName is string && data.requesterName.size() >= 1 && data.requesterName.size() <= 80 &&
        isOptionalSafeMediaUrl(data, 'requesterPhoto', 350000) &&
        data.recipientName is string && data.recipientName.size() >= 1 && data.recipientName.size() <= 80 &&
        isOptionalSafeMediaUrl(data, 'recipientPhoto', 350000) &&
        data.status in ['pending', 'accepted'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTypingStatus(data, typingId) {
      return data.keys().hasAll([
          'id', 'scope', 'roomKey', 'userId', 'userName', 'isTyping', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'scope', 'roomKey', 'userId', 'userName', 'isTyping', 'updatedAt'
        ]) &&
        data.id == typingId &&
        isValidId(data.id) &&
        data.scope in ['global', 'local'] &&
        data.roomKey is string && data.roomKey.matches('^(global|local_[A-Z]{2})$') &&
        isValidId(data.userId) &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
        data.isTyping is bool &&
        data.updatedAt is timestamp;
    }

    function isValidConversationTyping(data, conversationId, userId) {
      return data.keys().hasAll([
          'id', 'conversationId', 'participant1Id', 'participant2Id',
          'userId', 'userName', 'isTyping', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'conversationId', 'participant1Id', 'participant2Id',
          'userId', 'userName', 'isTyping', 'updatedAt'
        ]) &&
        data.id == userId &&
        data.conversationId == conversationId &&
        isValidId(data.id) &&
        isValidId(data.conversationId) &&
        isValidId(data.participant1Id) &&
        isValidId(data.participant2Id) &&
        isValidId(data.userId) &&
        data.userId == userId &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
        data.isTyping is bool &&
        data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    // 1. Public User Profiles + Private PII Subcollection + Blocked Users Subcollection
    match /users/{userId} {
      allow get: if isValidId(userId) && isVerifiedEmail();
      allow list: if isVerifiedEmail() && resource.data.isPublicProfile == true;

      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        incoming().isMuted == false &&
        incoming().isKicked == false &&
        incoming().isBanned == false &&
        (!('points' in incoming()) || incoming().points == 0) &&
        (!('completedBookingsCount' in incoming()) || incoming().completedBookingsCount == 0) &&
        (!('canPostStory' in incoming()) || incoming().canPostStory == false) &&
        (
          (incoming().role == 'customer' && (!('roles' in incoming()) || (incoming().roles.size() == 1 && incoming().roles[0] == 'customer'))) ||
          (isSuperAdmin() && incoming().role == 'admin' && (!('roles' in incoming()) || (incoming().roles.size() == 1 && incoming().roles[0] == 'admin')))
        );

      allow update: if isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        (
          (('createdAt' in existing()) && incoming().createdAt == existing().createdAt) ||
          (!('createdAt' in existing()) && incoming().createdAt == request.time)
        ) &&
        incoming().updatedAt == request.time &&
        incoming().isPublicProfile == true &&
        (
          (
            isSuperAdmin() &&
            (userId == request.auth.uid || (incoming().role != 'admin' && (!('roles' in incoming()) || !('admin' in incoming().roles))))
          ) ||
          (
            isStaffMember() &&
            existing().role != 'admin' &&
            (!('roles' in existing()) || !('admin' in existing().roles)) &&
            incoming().role == existing().role &&
            incoming().get('roles', [existing().role]) == existing().get('roles', [existing().role]) &&
            (
              (
                canBanMembers() &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'isMuted', 'muteReason', 'isKicked', 'kickReason', 'isBanned', 'banReason', 'updatedAt'
                ])
              ) ||
              (
                incoming().isBanned == existing().isBanned &&
                incoming().get('banReason', '') == existing().get('banReason', '') &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'isMuted', 'muteReason', 'isKicked', 'kickReason', 'updatedAt'
                ])
              )
            )
          ) ||
          (
            isOwner(userId) &&
            existing().get('isBanned', false) == false &&
            incoming().role == existing().get('role', 'customer') &&
            (
              incoming().get('roles', [incoming().role]) == existing().get('roles', [incoming().role]) ||
              ((!('roles' in existing()) || !(existing().roles is list) || existing().roles.size() == 0) && incoming().roles == [incoming().role])
            ) &&
            incoming().isMuted == existing().get('isMuted', false) &&
            incoming().isBanned == existing().get('isBanned', false) &&
            (
              // Standard owner profile edit (handle changes blocked if Founder special ID or reserved handle)
              (
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'displayName', 'username', 'photoURL', 'coverURL', 'bio', 'availability', 'liveStatus',
                  'salonName', 'addressLabel', 'location', 'services', 'countryCode',
                  'friendRequestPolicy', 'hideOnlineStatus', 'isOnline', 'lastActiveAt', 'updatedAt'
                ]) &&
                (
                  incoming().get('username', '') == existing().get('username', '') ||
                  (
                    existing().get('isSpecialId', false) == false &&
                    existing().get('specialIdGrantedBy', '') != 'admin' &&
                    !isReservedHandle(incoming().username)
                  )
                )
              ) ||
              // Legacy profile bootstrap cleanup (strip deprecated 'email' PII field or backfill missing required defaults)
              (
                (
                  ('email' in existing() && !('email' in incoming())) ||
                  !('createdAt' in existing()) ||
                  !('isPublicProfile' in existing()) ||
                  existing().isPublicProfile != true ||
                  !('availability' in existing()) ||
                  !('isMuted' in existing()) ||
                  !('isKicked' in existing()) ||
                  !('isBanned' in existing()) ||
                  !('roles' in existing()) ||
                  !(existing().roles is list) ||
                  existing().roles.size() == 0 ||
                  existing().get('displayName', '') == '' ||
                  !('points' in existing()) ||
                  !(existing().points is int) ||
                  existing().points < 0
                ) &&
                !('email' in incoming()) &&
                incoming().isKicked == existing().get('isKicked', false) &&
                (
                  incoming().displayName == existing().get('displayName', '') ||
                  (existing().get('displayName', '') == '' && incoming().displayName is string && incoming().displayName.size() >= 1)
                ) &&
                (
                  (('points' in existing()) && existing().points is int && existing().points >= 0 && incoming().points == existing().points) ||
                  (!('points' in existing()) && incoming().points == 0) ||
                  (('points' in existing()) && !(existing().points is int) && existing().points is number && existing().points >= 0 && incoming().points is int && incoming().points >= 0 && incoming().points <= int(existing().points) + 1) ||
                  (('points' in existing()) && existing().points is number && existing().points < 0 && incoming().points == 0) ||
                  (('points' in existing()) && !(existing().points is number) && incoming().points == 0)
                ) &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'email', 'username', 'countryCode', 'roles', 'availability', 'liveStatus',
                  'displayName', 'points', 'createdAt', 'isMuted', 'isKicked', 'isBanned',
                  'isPublicProfile', 'photoURL', 'coverURL', 'isOnline', 'lastActiveAt', 'updatedAt'
                ]) &&
                (
                  incoming().get('username', '') == existing().get('username', '') ||
                  (
                    existing().get('isSpecialId', false) == false &&
                    existing().get('specialIdGrantedBy', '') != 'admin' &&
                    !isReservedHandle(incoming().username)
                  )
                )
              ) ||
              // Self-unkick recovery
              (
                incoming().isKicked == false &&
                incoming().diff(existing()).affectedKeys().hasOnly(['isKicked', 'kickReason', 'updatedAt'])
              ) ||
              // Activity credit award (chat +2, gallery like +3, story +10, review +20, booking +25)
              (
                incoming().diff(existing()).affectedKeys().hasOnly(['points', 'updatedAt']) &&
                incoming().points is int &&
                incoming().points > existing().get('points', 0) &&
                incoming().points <= existing().get('points', 0) + 40
              ) ||
              // Daily login reward claim
              (
                incoming().diff(existing()).affectedKeys().hasOnly(['points', 'lastDailyClaimDate', 'updatedAt']) &&
                incoming().points is int &&
                incoming().points > existing().get('points', 0) &&
                incoming().points <= existing().get('points', 0) + getDailyRewardCap() &&
                incoming().lastDailyClaimDate != existing().get('lastDailyClaimDate', '')
              ) ||
              // Barber completed booking counter + reward (+40)
              (
                incoming().diff(existing()).affectedKeys().hasOnly(['completedBookingsCount', 'points', 'updatedAt']) &&
                incoming().completedBookingsCount is int &&
                incoming().completedBookingsCount == existing().get('completedBookingsCount', 0) + 1 &&
                (
                  !('points' in incoming()) ||
                  (incoming().points >= existing().get('points', 0) && incoming().points <= existing().get('points', 0) + 40)
                )
              ) ||
              // Store purchase 1: Special ID (exact point deduction + non-reserved + bounded expiration)
              (
                isStoreItemEnabled('special_id') &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'points', 'baseUsername', 'username', 'isSpecialId',
                  'specialIdLabel', 'specialIdExpiresAt', 'specialIdGrantedBy', 'updatedAt'
                ]) &&
                incoming().points is int &&
                incoming().points >= 0 &&
                (existing().get('points', 0) - incoming().points) == getStoreItemPrice('special_id', 250) &&
                incoming().isSpecialId == true &&
                incoming().specialIdGrantedBy == 'store' &&
                !isReservedHandle(incoming().username) &&
                incoming().specialIdExpiresAt is timestamp &&
                incoming().specialIdExpiresAt > request.time &&
                incoming().specialIdExpiresAt <= request.time + duration.value(getStoreItemDurationDays('special_id') + 1, 'd')
              ) ||
              // Store purchase 2: Name Color
              (
                isStoreItemEnabled('name_color') &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'points', 'nameColor', 'nameColorExpiresAt', 'updatedAt'
                ]) &&
                incoming().points is int &&
                incoming().points >= 0 &&
                (existing().get('points', 0) - incoming().points) == getStoreItemPrice('name_color', 120) &&
                incoming().nameColor in ['gold_royal', 'emerald_neon', 'crimson_ruby', 'sapphire_sky', 'violet_amethyst'] &&
                incoming().nameColorExpiresAt is timestamp &&
                incoming().nameColorExpiresAt > request.time &&
                incoming().nameColorExpiresAt <= request.time + duration.value(getStoreItemDurationDays('name_color') + 1, 'd')
              ) ||
              // Store purchase 3: Tiered Credit Store Avatar Frames
              (
                isStoreItemEnabled('avatar_frame') &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'points', 'avatarFrame', 'avatarFrameExpiresAt', 'updatedAt'
                ]) &&
                incoming().points is int &&
                incoming().points >= 0 &&
                (
                  (incoming().avatarFrame == 'obsidian_bronze' && (existing().get('points', 0) - incoming().points) == 100) ||
                  (incoming().avatarFrame == 'emerald_royal' && (existing().get('points', 0) - incoming().points) == 140) ||
                  (incoming().avatarFrame == 'gold_crown' && (existing().get('points', 0) - incoming().points) == 150) ||
                  (incoming().avatarFrame == 'ruby_flame' && (existing().get('points', 0) - incoming().points) == 180) ||
                  (incoming().avatarFrame == 'sapphire_neon' && (existing().get('points', 0) - incoming().points) == 200) ||
                  (incoming().avatarFrame == 'platinum_diamond' && (existing().get('points', 0) - incoming().points) == 260)
                ) &&
                incoming().avatarFrameExpiresAt is timestamp &&
incoming().avatarFrameExpiresAt > request.time &&
                incoming().avatarFrameExpiresAt <= request.time + duration.value(getStoreItemDurationDays('avatar_frame') + 1, 'd')
              ) ||
              // Free Rank-Locked Avatar Frame Equip / Unequip (zero points deducted)
              (
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'avatarFrame', 'avatarFrameExpiresAt', 'updatedAt'
                ]) &&
                incoming().avatarFrameExpiresAt == null &&
                (
                  incoming().avatarFrame == '' ||
                  (incoming().avatarFrame == 'founder_sovereign' && (isSuperAdmin() || userHasRole(existing(), 'admin'))) ||
                  (incoming().avatarFrame == 'rank_deputy' && (isSuperAdmin() || userHasRole(existing(), 'admin') || userHasRole(existing(), 'deputy_director'))) ||
                  (incoming().avatarFrame == 'rank_moderator' && (isSuperAdmin() || userHasRole(existing(), 'admin') || userHasRole(existing(), 'moderator'))) ||
                  (incoming().avatarFrame == 'rank_chat_mod' && (isSuperAdmin() || userHasRole(existing(), 'admin') || userHasRole(existing(), 'chat_moderator'))) ||
                  (incoming().avatarFrame == 'rank_vip_barber' && (isSuperAdmin() || userHasRole(existing(), 'admin') || userHasRole(existing(), 'vip_barber'))) ||
                  (incoming().avatarFrame == 'rank_master_barber' && (isSuperAdmin() || userHasRole(existing(), 'admin') || userHasRole(existing(), 'master_barber'))) ||
                  (incoming().avatarFrame == 'rank_verified_barber' && (isSuperAdmin() || userHasRole(existing(), 'admin') || userHasRole(existing(), 'barber_verified'))) ||
                  (incoming().avatarFrame == 'rank_vip_member' && (isSuperAdmin() || userHasRole(existing(), 'admin') || userHasRole(existing(), 'vip_member')))
                )
              ) ||
              // Store purchase 4: Chat Distinction Title
              (
                isStoreItemEnabled('chat_title') &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'points', 'chatTitle', 'chatTitleExpiresAt', 'updatedAt'
                ]) &&
                incoming().points is int &&
                incoming().points >= 0 &&
                (existing().get('points', 0) - incoming().points) == getStoreItemPrice('chat_title', 90) &&
                (
                  incoming().chatTitle in ['community_star', 'refined_taste', 'guest_of_honor', 'elite_supporter', 'style_icon'] ||
                  (incoming().chatTitle == 'founder_dean' && (isSuperAdmin() || userHasRole(existing(), 'admin')))
                ) &&
                incoming().chatTitleExpiresAt is timestamp &&
                incoming().chatTitleExpiresAt > request.time &&
                incoming().chatTitleExpiresAt <= request.time + duration.value(getStoreItemDurationDays('chat_title') + 1, 'd')
              ) ||
              // Store purchase 5: Credit Pass
              (
                isStoreItemEnabled('credit_pass') &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'points', 'creditPassTier', 'creditPassExpiresAt', 'updatedAt'
                ]) &&
                incoming().points is int &&
                incoming().points >= 0 &&
                (existing().get('points', 0) - incoming().points) == getStoreItemPrice('credit_pass', 200) &&
                incoming().creditPassTier == 'aurelius_credit_pass' &&
                incoming().creditPassExpiresAt is timestamp &&
                incoming().creditPassExpiresAt > request.time &&
                incoming().creditPassExpiresAt <= request.time + duration.value(getStoreItemDurationDays('credit_pass') + 1, 'd')
              ) ||
              // Expired Special ID cleanup back to base numeric ID
              (
                existing().get('isSpecialId', false) == true &&
                'specialIdExpiresAt' in existing() &&
                existing().specialIdExpiresAt is timestamp &&
                existing().specialIdExpiresAt <= request.time &&
                incoming().isSpecialId == false &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'username', 'isSpecialId', 'specialIdLabel', 'specialIdExpiresAt', 'specialIdGrantedBy', 'updatedAt'
                ])
              )
            )
          )
        );

      // Owner self-deletion (non-admin) or Founder deletion of non-self users
      allow delete: if isValidId(userId) && (
        (isOwner(userId) && !isSuperAdmin() && existing().role != 'admin') ||
        (isSuperAdmin() && userId != request.auth.uid)
      );

      match /private/info {
        allow get: if isValidId(userId) && (isOwner(userId) || isSuperAdmin());
        allow create: if isValidId(userId) &&
          isOwner(userId) &&
          isValidUserPrivateInfo(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(userId) &&
          (isOwner(userId) || isSuperAdmin()) &&
          isValidUserPrivateInfo(incoming(), userId) &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
        allow delete: if isValidId(userId) && (isOwner(userId) || isSuperAdmin());
      }

      match /blockedUsers/{blockedUid} {
        allow get, list: if isValidId(userId) && (isOwner(userId) || isSuperAdmin());
        allow create: if isValidId(userId) &&
          isValidId(blockedUid) &&
          isOwner(userId) &&
          isNotBanned() &&
          blockedUid != request.auth.uid &&
          isValidBlockedUser(incoming(), userId, blockedUid) &&
          incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(blockedUid) && (isOwner(userId) || isSuperAdmin());
      }
    }

    // 2. Barber Verification Requests
    match /verificationRequests/{requestId} {
      allow get: if isValidId(requestId) && isVerifiedEmail() &&
        (existing().userId == request.auth.uid || isSuperAdmin());
      allow list: if isSuperAdmin() ||
        (isVerifiedEmail() && resource.data.userId == request.auth.uid);

      allow create: if isValidId(requestId) &&
        isVerifiedEmail() &&
        isNotBanned() &&
        isValidVerificationRequest(incoming(), requestId) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(requestId) &&
        isSuperAdmin() &&
        isValidVerificationRequest(incoming(), requestId) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().status in ['approved', 'rejected'] &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNote', 'updatedAt']);

      allow delete: if isValidId(requestId) && (isSuperAdmin() || isOwner(existing().userId));
    }

    // 3. Gallery (VIP / Master Barbers & Founder)
    match /gallery/{itemId} {
      allow get: if isValidId(itemId) && isVerifiedEmail();
      allow list: if isVerifiedEmail() && resource.data.visibility == 'public';

      allow create: if isValidId(itemId) &&
        isVipBarberOrAdmin() &&
        isValidGalleryItem(incoming(), itemId) &&
        (incoming().barberId == request.auth.uid || isSuperAdmin()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(itemId) &&
        isValidGalleryItem(incoming(), itemId) &&
        incoming().id == existing().id &&
        incoming().barberId == existing().barberId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isSuperAdmin() ||
          (
            isOwner(existing().barberId) &&
            isVipBarberOrAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'description', 'category', 'imageUrl',
              'isBeforeAfter', 'beforeImageUrl', 'barberName', 'barberPhoto', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(itemId) && (isSuperAdmin() || (isOwner(existing().barberId) && isNotBanned()));
    }

    // 4. Dual Likes (Barber Profiles & Individual Gallery Works)
    match /likes/{likeId} {
      allow get: if isValidId(likeId) && isVerifiedEmail();
      allow list: if isVerifiedEmail() && (resource.data.targetType == 'profile' || resource.data.targetType == 'gallery');

      allow create: if isValidId(likeId) &&
        isVerifiedEmail() &&
        isNotBanned() &&
        isValidLikeRecord(incoming(), likeId) &&
        incoming().userId == request.auth.uid &&
        likeId == (incoming().targetType + '_' + incoming().targetId + '_' + request.auth.uid) &&
        incoming().createdAt == request.time;

      allow delete: if isValidId(likeId) && isVerifiedEmail() && (existing().userId == request.auth.uid || isSuperAdmin());
    }

    // 5. Confidential Support Tickets & Staff Queue
    match /supportTickets/{ticketId} {
      allow get: if isValidId(ticketId) && isVerifiedEmail() &&
        (existing().userId == request.auth.uid || isModeratorOrAdmin());
      allow list: if isModeratorOrAdmin() ||
        (isVerifiedEmail() && resource.data.userId == request.auth.uid);

      allow create: if isValidId(ticketId) &&
        isVerifiedEmail() &&
        isNotBanned() &&
        isValidSupportTicket(incoming(), ticketId) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'open' &&
        (!('assignedModeratorId' in incoming()) || incoming().assignedModeratorId == '') &&
        (!('assignedModeratorName' in incoming()) || incoming().assignedModeratorName == '') &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        incoming().lastMessageAt == request.time;

      allow update: if isValidId(ticketId) &&
        isVerifiedEmail() &&
        isNotBanned() &&
        isValidSupportTicket(incoming(), ticketId) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isSuperAdmin() ||
          (
            existing().status != 'closed' &&
            (
              (
                isModeratorOrAdmin() &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'status', 'assignedModeratorId', 'assignedModeratorName',
                  'resolutionNote', 'lastMessage', 'lastMessageAt', 'updatedAt'
                ])
              ) ||
              (
                isOwner(existing().userId) &&
                (
                  (
                    incoming().status == existing().status &&
                    incoming().diff(existing()).affectedKeys().hasOnly([
                      'lastMessage', 'lastMessageAt', 'updatedAt'
                    ])
                  ) ||
                  (
                    incoming().status == 'closed' &&
                    incoming().diff(existing()).affectedKeys().hasOnly([
                      'status', 'resolutionNote', 'updatedAt'
                    ])
                  )
                )
              )
            )
          )
        );

      allow delete: if isValidId(ticketId) && (isSuperAdmin() || isOwner(existing().userId));

      match /messages/{messageId} {
        allow get: if isValidId(ticketId) && isValidId(messageId) && isVerifiedEmail() &&
          (existing().ticketOwnerId == request.auth.uid || isModeratorOrAdmin());
        allow list: if isModeratorOrAdmin() ||
          (
            isVerifiedEmail() &&
            resource.data.ticketId == ticketId &&
            resource.data.ticketOwnerId == request.auth.uid
          );

        allow create: if isValidId(ticketId) && isValidId(messageId) &&
          isVerifiedEmail() &&
          isNotBanned() &&
          isValidSupportTicketMessage(incoming(), ticketId, messageId) &&
          incoming().senderId == request.auth.uid &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/supportTickets/$(ticketId)) &&
          get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.userId == incoming().ticketOwnerId &&
          (
            isSuperAdmin() ||
            (
              get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.status != 'closed' &&
              (
                incoming().ticketOwnerId == request.auth.uid ||
                isModeratorOrAdmin()
              )
            )
          );

        allow delete: if isValidId(ticketId) && isValidId(messageId) &&
          (isSuperAdmin() || isOwner(existing().ticketOwnerId));
      }
    }

    // 6. Community Chat
    match /communityMessages/{messageId} {
      allow get: if isValidId(messageId) && isVerifiedEmail();
      allow list: if isVerifiedEmail() && resource.data.visibility == 'public';

      allow create: if isValidId(messageId) &&
        isVerifiedEmail() &&
        isNotMutedOrKicked() &&
        isValidCommunityMessage(incoming(), messageId) &&
        incoming().senderId == request.auth.uid &&
        incoming().edited == false &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(messageId) &&
        isValidCommunityMessage(incoming(), messageId) &&
        incoming().id == existing().id &&
        incoming().senderId == existing().senderId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isModeratorOrAdmin() ||
          (
            isOwner(existing().senderId) &&
            isNotMutedOrKicked() &&
            incoming().edited == true &&
            incoming().diff(existing()).affectedKeys().hasOnly(['text', 'edited', 'updatedAt'])
          )
        );

      allow delete: if isValidId(messageId) && (isModeratorOrAdmin() || (isOwner(existing().senderId) && isNotBanned()));
    }
    // 7. Profile Posts
    match /posts/{postId} {
      allow get: if isValidId(postId) && isVerifiedEmail();
      allow list: if isVerifiedEmail() && resource.data.visibility == 'public';

      allow create: if isValidId(postId) &&
        isVerifiedEmail() &&
        isNotBanned() &&
        isValidProfilePost(incoming(), postId) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(postId) &&
        isValidProfilePost(incoming(), postId) &&
        incoming().id == existing().id &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isSuperAdmin() ||
          (
            isOwner(existing().authorId) &&
            isNotBanned() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'text', 'imageUrl', 'authorName', 'authorPhoto', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(postId) && (isSuperAdmin() || isModeratorOrAdmin() || (isOwner(existing().authorId) && isNotBanned()));
    }

    // 8. Private Conversations & Messages Subcollection
    match /conversations/{conversationId} {
      allow get: if isValidId(conversationId) && isVerifiedEmail() &&
        (existing().participant1Id == request.auth.uid || existing().participant2Id == request.auth.uid);
      allow list: if isVerifiedEmail() &&
        (resource.data.participant1Id == request.auth.uid || resource.data.participant2Id == request.auth.uid);

      allow create: if isValidId(conversationId) &&
        isVerifiedEmail() &&
        isNotBanned() &&
        isValidConversation(incoming(), conversationId) &&
        (incoming().participant1Id == request.auth.uid || incoming().participant2Id == request.auth.uid) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(conversationId) &&
        isVerifiedEmail() &&
        isNotBanned() &&
        isValidConversation(incoming(), conversationId) &&
        (existing().participant1Id == request.auth.uid || existing().participant2Id == request.auth.uid) &&
        incoming().id == existing().id &&
        incoming().participant1Id == existing().participant1Id &&
        incoming().participant2Id == existing().participant2Id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'lastMessage', 'lastMessageAt', 'participant1Name', 'participant2Name',
          'participant1Photo', 'participant2Photo', 'updatedAt'
        ]);

      allow delete: if isValidId(conversationId) && isVerifiedEmail() &&
        (existing().participant1Id == request.auth.uid || existing().participant2Id == request.auth.uid);

      match /messages/{messageId} {
        allow get: if isValidId(conversationId) && isValidId(messageId) && isVerifiedEmail() &&
          (existing().participant1Id == request.auth.uid || existing().participant2Id == request.auth.uid);
        allow list: if isVerifiedEmail() &&
          resource.data.conversationId == conversationId &&
          (resource.data.participant1Id == request.auth.uid || resource.data.participant2Id == request.auth.uid);

        allow create: if isValidId(conversationId) && isValidId(messageId) &&
          isVerifiedEmail() &&
          isNotBanned() &&
          isValidPrivateMessage(incoming(), conversationId, messageId) &&
          incoming().senderId == request.auth.uid &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participant1Id == incoming().participant1Id &&
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participant2Id == incoming().participant2Id &&
          (incoming().participant1Id == request.auth.uid || incoming().participant2Id == request.auth.uid);

        allow delete: if isValidId(conversationId) && isValidId(messageId) && isVerifiedEmail() &&
          (existing().participant1Id == request.auth.uid || existing().participant2Id == request.auth.uid);
      }

      match /typing/{userId} {
        allow get: if isValidId(conversationId) && isValidId(userId) && isVerifiedEmail() &&
          (existing().participant1Id == request.auth.uid || existing().participant2Id == request.auth.uid);
        allow list: if isVerifiedEmail() &&
          resource.data.conversationId == conversationId &&
          (resource.data.participant1Id == request.auth.uid || resource.data.participant2Id == request.auth.uid);

        allow create, update: if isValidId(conversationId) && isValidId(userId) &&
          isVerifiedEmail() &&
          isNotBanned() &&
          userId == request.auth.uid &&
          isValidConversationTyping(incoming(), conversationId, userId) &&
          incoming().userId == request.auth.uid &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participant1Id == incoming().participant1Id &&
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participant2Id == incoming().participant2Id &&
          (incoming().participant1Id == request.auth.uid || incoming().participant2Id == request.auth.uid);

        allow delete: if isValidId(conversationId) && isValidId(userId) && isVerifiedEmail() &&
          (userId == request.auth.uid || existing().participant1Id == request.auth.uid || existing().participant2Id == request.auth.uid);
      }
    }

    // 9. Bookings (Appointment Reservations with Barbers)
    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && isVerifiedEmail() &&
        (existing().customerId == request.auth.uid || existing().barberId == request.auth.uid || isSuperAdmin());
      allow list: if isVerifiedEmail() &&
        (resource.data.customerId == request.auth.uid || resource.data.barberId == request.auth.uid || isSuperAdmin());

      allow create: if isValidId(bookingId) &&
        isVerifiedEmail() &&
        isNotBanned() &&
        isValidBooking(incoming(), bookingId) &&
        incoming().customerId == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().reviewed == false &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        userExists(incoming().barberId) &&
        (
          userHasRole(getUserData(incoming().barberId), 'barber_verified') ||
          userHasRole(getUserData(incoming().barberId), 'master_barber') ||
          userHasRole(getUserData(incoming().barberId), 'vip_barber') ||
          hasDynamicRolePerm(getUserData(incoming().barberId), 'receiveBookings')
        );

      allow update: if isValidId(bookingId) &&
        isVerifiedEmail() &&
        isNotBanned() &&
        isValidBooking(incoming(), bookingId) &&
        incoming().id == existing().id &&
        incoming().conversationId == existing().conversationId &&
        incoming().customerId == existing().customerId &&
        incoming().barberId == existing().barberId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isSuperAdmin() ||
          (
            existing().reviewed == false &&
            existing().barberId == request.auth.uid &&
            incoming().reviewed == existing().reviewed &&
            incoming().status in ['pending', 'confirmed', 'rescheduled', 'rejected', 'completed', 'cancelled'] &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'date', 'time', 'notes', 'updatedAt'])
          ) ||
          (
            !(existing().status in ['rejected', 'cancelled', 'completed']) &&
            existing().customerId == request.auth.uid &&
            incoming().reviewed == existing().reviewed &&
            (
              (incoming().status == 'cancelled' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
              (existing().status == 'rescheduled' && incoming().status == 'confirmed' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
            )
          ) ||
          (
            existing().customerId == request.auth.uid &&
            existing().status == 'completed' &&
            existing().reviewed == false &&
            incoming().status == 'completed' &&
            incoming().reviewed == true &&
            incoming().diff(existing()).affectedKeys().hasOnly(['reviewed', 'updatedAt'])
          )
        );

      allow delete: if isValidId(bookingId) && isVerifiedEmail() &&
        (isSuperAdmin() || (isNotBanned() && (existing().customerId == request.auth.uid || existing().barberId == request.auth.uid)));
    }

    // 10. Reviews (Post-Appointment Star Ratings)
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && isVerifiedEmail();
      allow list: if isVerifiedEmail() && resource.data.visibility == 'public';

      allow create: if isValidId(reviewId) &&
        isVerifiedEmail() &&
        isNotBanned() &&
        isValidReview(incoming(), reviewId) &&
        incoming().customerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/bookings/$(incoming().bookingId)) &&
        get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.customerId == request.auth.uid &&
        get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.barberId == incoming().barberId &&
        get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.status == 'completed';

      allow delete: if isValidId(reviewId) && (isSuperAdmin() || isOwner(existing().customerId));
    }

    // 11. Live Notifications
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isVerifiedEmail() &&
        (existing().recipientId == request.auth.uid || isSuperAdmin());
      allow list: if isVerifiedEmail() &&
        (resource.data.recipientId == request.auth.uid || isSuperAdmin());

      allow create: if isValidId(notificationId) &&
        isVerifiedEmail() &&
        isNotBanned() &&
        isValidNotification(incoming(), notificationId) &&
        incoming().senderId == request.auth.uid &&
        incoming().read == false &&
        incoming().createdAt == request.time;

      allow update: if isValidId(notificationId) &&
        isVerifiedEmail() &&
        isValidNotification(incoming(), notificationId) &&
        isOwner(existing().recipientId) &&
        incoming().id == existing().id &&
        incoming().recipientId == existing().recipientId &&
        incoming().senderId == existing().senderId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['read']);

      allow delete: if isValidId(notificationId) && (isOwner(existing().recipientId) || isSuperAdmin());
    }

    // 12. Activity Logs (Staff & Founder Oversight)
    match /activityLogs/{logId} {
      allow get: if isValidId(logId) && isModeratorOrAdmin();
      allow list: if isModeratorOrAdmin();

      allow create: if isValidId(logId) &&
        isModeratorOrAdmin() &&
        isValidActivityLog(incoming(), logId) &&
        incoming().actorId == request.auth.uid &&
        incoming().createdAt == request.time;
    }

    // 13. Confidential Staff Coordination Chat
    match /staffMessages/{messageId} {
      allow get: if isValidId(messageId) && isModeratorOrAdmin();
      allow list: if isModeratorOrAdmin();

      allow create: if isValidId(messageId) &&
        isModeratorOrAdmin() &&
        isValidStaffMessage(incoming(), messageId) &&
        incoming().senderId == request.auth.uid &&
        incoming().edited == false &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(messageId) &&
        isModeratorOrAdmin() &&
        isValidStaffMessage(incoming(), messageId) &&
        incoming().id == existing().id &&
        incoming().senderId == existing().senderId &&
        incoming().senderRole == existing().senderRole &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isSuperAdmin() ||
          (
            isOwner(existing().senderId) &&
            incoming().edited == true &&
            incoming().diff(existing()).affectedKeys().hasOnly(['text', 'edited', 'updatedAt'])
          )
        );

      allow delete: if isValidId(messageId) && isModeratorOrAdmin() && (isSuperAdmin() || isOwner(existing().senderId));
    }

    // 14. Moderator Onboarding Guidelines (Readable by Staff, Managed Exclusively by Founder)
    match /staffGuidelines/{guidelineId} {
      allow get: if isValidId(guidelineId) && isModeratorOrAdmin();
      allow list: if isModeratorOrAdmin();

      allow create: if isValidId(guidelineId) &&
        isSuperAdmin() &&
        isValidStaffGuideline(incoming(), guidelineId) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(guidelineId) &&
        isSuperAdmin() &&
        isValidStaffGuideline(incoming(), guidelineId) &&
        incoming().id == existing().id &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'content', 'updatedAt']);

      allow delete: if isValidId(guidelineId) && isSuperAdmin();
    }

    // 15. Aurelius Look of the Season Votes
    match /seasonVotes/{voteId} {
      allow get: if isValidId(voteId) && isVerifiedEmail();
      allow list: if isVerifiedEmail() && resource.data.seasonKey is string;

      allow create: if isValidId(voteId) &&
        isVerifiedEmail() &&
        isNotBanned() &&
        isValidSeasonVote(incoming(), voteId) &&
        incoming().voterId == request.auth.uid &&
        voteId == (incoming().seasonKey + '_' + request.auth.uid) &&
        (isSuperAdmin() || isSeasonVotingActive(incoming().seasonKey)) &&
        exists(/databases/$(database)/documents/gallery/$(incoming().galleryItemId)) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(voteId) &&
        isVerifiedEmail() &&
        isNotBanned() &&
        isValidSeasonVote(incoming(), voteId) &&
        existing().voterId == request.auth.uid &&
        incoming().id == existing().id &&
        incoming().voterId == existing().voterId &&
        incoming().seasonKey == existing().seasonKey &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (isSuperAdmin() || isSeasonVotingActive(existing().seasonKey)) &&
        exists(/databases/$(database)/documents/gallery/$(incoming().galleryItemId)) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['galleryItemId', 'barberId', 'updatedAt']);

      allow delete: if isValidId(voteId) && isVerifiedEmail() &&
        (isSuperAdmin() || (isNotBanned() && existing().voterId == request.auth.uid && isSeasonVotingActive(existing().seasonKey)));
    }

    // 16. Aurelius Look of the Season Champion Awards
    match /seasonAwards/{seasonKey} {
      allow get: if isValidId(seasonKey) && isVerifiedEmail();
      allow list: if isVerifiedEmail() && resource.data.seasonKey is string;

      allow create: if isValidId(seasonKey) &&
        isSuperAdmin() &&
        isValidSeasonAward(incoming(), seasonKey) &&
        incoming().awardedById == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(seasonKey) &&
        isSuperAdmin() &&
        isValidSeasonAward(incoming(), seasonKey) &&
        incoming().id == existing().id &&
        incoming().seasonKey == existing().seasonKey &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;

      allow delete: if isValidId(seasonKey) && isSuperAdmin();
    }

    // 16b. Look of the Season Configuration
    match /seasonConfig/{configId} {
      allow get: if isValidId(configId) && isVerifiedEmail();
      allow list: if isVerifiedEmail();

      allow create: if isValidId(configId) &&
        configId == 'current' &&
        isSuperAdmin() &&
        isValidSeasonConfig(incoming(), configId) &&
        incoming().updatedById == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(configId) &&
        configId == 'current' &&
        isSuperAdmin() &&
        isValidSeasonConfig(incoming(), configId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedById == request.auth.uid &&
        incoming().updatedAt == request.time;

      allow delete: if isValidId(configId) && isSuperAdmin();
    }

    // 17. Aurelius Stories (24-Hour Ephemeral Updates)
    match /stories/{storyId} {
      allow get: if isValidId(storyId) && isVerifiedEmail();
      allow list: if isVerifiedEmail() && resource.data.visibility == 'public';

      allow create: if isValidId(storyId) &&
        canPublishStory() &&
        isValidBarberStory(incoming(), storyId) &&
        (incoming().barberId == request.auth.uid || isSuperAdmin()) &&
        incoming().createdAt == request.time &&
        incoming().expiresAt > request.time &&
        incoming().expiresAt <= request.time + duration.value(25, 'h');

      allow delete: if isValidId(storyId) && (isSuperAdmin() || isModeratorOrAdmin() || isOwner(existing().barberId));
    }

    // 17b. Aurelius Story Quick Reactions
    match /storyReactions/{reactionId} {
      allow get: if isValidId(reactionId) && isVerifiedEmail();
      allow list: if isVerifiedEmail() && (
        resource.data.userId == request.auth.uid ||
        resource.data.storyAuthorId == request.auth.uid ||
        resource.data.storyId is string
      );

      allow create: if isValidId(reactionId) &&
        isVerifiedEmail() &&
        isNotBanned() &&
        isValidStoryReaction(incoming(), reactionId) &&
        incoming().userId == request.auth.uid &&
        (
          reactionId == (incoming().storyId + '_' + request.auth.uid) ||
          ('emojiKey' in incoming() && reactionId == (incoming().storyId + '_' + request.auth.uid + '_' + incoming().emojiKey))
        ) &&
        exists(/databases/$(database)/documents/stories/$(incoming().storyId)) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(reactionId) &&
        isVerifiedEmail() &&
        isNotBanned() &&
        isValidStoryReaction(incoming(), reactionId) &&
        existing().userId == request.auth.uid &&
        incoming().id == existing().id &&
        incoming().storyId == existing().storyId &&
        incoming().storyAuthorId == existing().storyAuthorId &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['reaction', 'emojiKey', 'userName', 'userPhoto', 'updatedAt']);

      allow delete: if isValidId(reactionId) && isVerifiedEmail() &&
        (
          isSuperAdmin() ||
          isModeratorOrAdmin() ||
          (isNotBanned() && (existing().userId == request.auth.uid || existing().storyAuthorId == request.auth.uid))
        );
    }

    // 18. Platform Coming Soon & Dev Log Announcements
    match /platformAnnouncements/{announcementId} {
      allow get: if isValidId(announcementId) && isVerifiedEmail();
      allow list: if isVerifiedEmail() && resource.data.visibility == 'public';

      allow create: if isValidId(announcementId) &&
        isSuperAdmin() &&
        isValidPlatformAnnouncement(incoming(), announcementId) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(announcementId) &&
        isSuperAdmin() &&
        isValidPlatformAnnouncement(incoming(), announcementId) &&
        incoming().id == existing().id &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'summary', 'badge', 'targetWindow', 'isPinned', 'updatedAt'
        ]);

      allow delete: if isValidId(announcementId) && isSuperAdmin();
    }

    // 19. Member Friendships & Friend Requests
    match /friendships/{friendshipId} {
      allow get: if isValidId(friendshipId) && isVerifiedEmail() &&
        (existing().user1Id == request.auth.uid || existing().user2Id == request.auth.uid);
      allow list: if isVerifiedEmail() &&
        (resource.data.user1Id == request.auth.uid || resource.data.user2Id == request.auth.uid);

      allow create: if isValidId(friendshipId) &&
        isVerifiedEmail() &&
        isNotBanned() &&
        isValidFriendship(incoming(), friendshipId) &&
        incoming().requesterId == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        userExists(incoming().recipientId) &&
        (
          !('friendRequestPolicy' in getUserData(incoming().recipientId)) ||
          getUserData(incoming().recipientId).friendRequestPolicy == 'everyone' ||
          (getUserData(incoming().recipientId).friendRequestPolicy == 'barbers_only' && isAnyBarberOrAdmin())
        );

      allow update: if isValidId(friendshipId) &&
        isVerifiedEmail() &&
        isNotBanned() &&
        isValidFriendship(incoming(), friendshipId) &&
        existing().status == 'pending' &&
        incoming().status == 'accepted' &&
        existing().recipientId == request.auth.uid &&
        incoming().id == existing().id &&
        incoming().user1Id == existing().user1Id &&
        incoming().user2Id == existing().user2Id &&
        incoming().requesterId == existing().requesterId &&
        incoming().recipientId == existing().recipientId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isValidId(friendshipId) && isVerifiedEmail() &&
        (existing().user1Id == request.auth.uid || existing().user2Id == request.auth.uid || isSuperAdmin());
    }

    // 20. Live Community Typing Indicators
    match /typingStatuses/{typingId} {
      allow get: if isValidId(typingId) && isVerifiedEmail();
      allow list: if isVerifiedEmail() && resource.data.scope in ['global', 'local'];

      allow create, update: if isValidId(typingId) &&
        isVerifiedEmail() &&
        isNotMutedOrKicked() &&
        isValidTypingStatus(incoming(), typingId) &&
        incoming().userId == request.auth.uid &&
        typingId == (incoming().roomKey + '_' + request.auth.uid) &&
        incoming().updatedAt == request.time;

      allow delete: if isValidId(typingId) && isVerifiedEmail() &&
        (existing().userId == request.auth.uid || isSuperAdmin());
    }

    // 21. Dynamic Role Definitions (Founder Only Write, Members Read)
    match /roleDefinitions/{roleId} {
      allow get: if isValidRoleId(roleId) && isVerifiedEmail();
      allow list: if isVerifiedEmail();

      allow create: if isValidRoleId(roleId) &&
        roleId != 'admin' &&
        isSuperAdmin() &&
        isValidRoleDefinition(incoming(), roleId) &&
        incoming().createdById == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidRoleId(roleId) &&
        roleId != 'admin' &&
        isSuperAdmin() &&
        isValidRoleDefinition(incoming(), roleId) &&
        incoming().id == existing().id &&
        incoming().createdById == existing().createdById &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;

      allow delete: if isValidRoleId(roleId) && roleId != 'admin' && isSuperAdmin();
    }

    // 22. Global Temporary Store & Credits Configuration (Founder Only Write, Members Read)
    match /storeConfig/{configId} {
      allow get: if isValidId(configId) && isVerifiedEmail();
      allow list: if isVerifiedEmail();

      allow create: if isValidId(configId) &&
        configId == 'current' &&
        isSuperAdmin() &&
        isValidStoreConfig(incoming(), configId) &&
        incoming().updatedById == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(configId) &&
        configId == 'current' &&
        isSuperAdmin() &&
        isValidStoreConfig(incoming(), configId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedById == request.auth.uid &&
        incoming().updatedAt == request.time;

      allow delete: if isValidId(configId) && isSuperAdmin();
    }

    // 23. User-Submitted Safety & Moderation Content Reports
    match /contentReports/{reportId} {
      allow get: if isValidId(reportId) && isVerifiedEmail() &&
        (existing().reporterId == request.auth.uid || isStaffMember());
      allow list: if isStaffMember() ||
        (isVerifiedEmail() && resource.data.reporterId == request.auth.uid);

      allow create: if isValidId(reportId) &&
        isVerifiedEmail() &&
        isNotBanned() &&
        isValidContentReport(incoming(), reportId) &&
        incoming().reporterId == request.auth.uid &&
        incoming().targetOwnerId != request.auth.uid &&
        incoming().status == 'pending' &&
        !('reviewedById' in incoming()) &&
        !('reviewedByName' in incoming()) &&
        !('resolutionNote' in incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(reportId) &&
        isStaffMember() &&
        isValidContentReport(incoming(), reportId) &&
        incoming().id == existing().id &&
        incoming().reporterId == existing().reporterId &&
        incoming().targetType == existing().targetType &&
        incoming().targetId == existing().targetId &&
        incoming().targetOwnerId == existing().targetOwnerId &&
        incoming().category == existing().category &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().status in ['pending', 'reviewed', 'dismissed'] &&
        incoming().reviewedById == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'reviewedById', 'reviewedByName', 'resolutionNote', 'updatedAt'
        ]);

      allow delete: if isValidId(reportId) && isSuperAdmin();
    }
  }
}
