rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidRoleId(roleStr) {
      return roleStr is string && roleStr.size() >= 1 && roleStr.size() <= 64 && roleStr.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedEmail() && request.auth.uid == userId;
    }

    // Sole Exclusive Founder / Super Admin
    function isSuperAdmin() {
      return isVerifiedEmail() && request.auth.token.email == 'hossambassmaji53@gmail.com';
    }

    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function userHasRole(userData, targetRole) {
      return userData.role == targetRole ||
        ('roles' in userData && userData.roles is list && targetRole in userData.roles);
    }

    function hasDynamicRolePerm(userData, permKey) {
      return exists(/databases/$(database)/documents/roleDefinitions/$(userData.role)) &&
        'permissions' in get(/databases/$(database)/documents/roleDefinitions/$(userData.role)).data &&
        get(/databases/$(database)/documents/roleDefinitions/$(userData.role)).data.permissions.get(permKey, false) == true;
    }

    function isStaffMember() {
      return isSuperAdmin() || (
        isVerifiedEmail() &&
        userExists(request.auth.uid) &&
        getUserData(request.auth.uid).isBanned == false &&
        (
          userHasRole(getUserData(request.auth.uid), 'deputy_director') ||
          userHasRole(getUserData(request.auth.uid), 'moderator') ||
          userHasRole(getUserData(request.auth.uid), 'chat_moderator') ||
          hasDynamicRolePerm(getUserData(request.auth.uid), 'accessStaffRoom')
        )
      );
    }

    function isModeratorOrAdmin() {
      return isStaffMember();
    }

    function canBanMembers() {
      return isSuperAdmin() || (
        isVerifiedEmail() &&
        userExists(request.auth.uid) &&
        getUserData(request.auth.uid).isBanned == false &&
        (
          userHasRole(getUserData(request.auth.uid), 'deputy_director') ||
          userHasRole(getUserData(request.auth.uid), 'moderator') ||
          hasDynamicRolePerm(getUserData(request.auth.uid), 'banUsers')
        )
      );
    }

    // Gallery Publishing Gate: VIP Barber, Master Barber, dynamic permission, or Founder
    function isVipBarberOrAdmin() {
      return isSuperAdmin() || (
        isVerifiedEmail() &&
        userExists(request.auth.uid) &&
        getUserData(request.auth.uid).isBanned == false &&
        (
          userHasRole(getUserData(request.auth.uid), 'vip_barber') ||
          userHasRole(getUserData(request.auth.uid), 'master_barber') ||
          hasDynamicRolePerm(getUserData(request.auth.uid), 'publishGallery')
        )
      );
    }

    function isNotBanned() {
      return isSuperAdmin() || (
        userExists(request.auth.uid) &&
        getUserData(request.auth.uid).isBanned == false
      );
    }

    function isNotMutedOrKicked() {
      return isSuperAdmin() || (
        userExists(request.auth.uid) &&
        getUserData(request.auth.uid).isBanned == false &&
        getUserData(request.auth.uid).isMuted == false &&
        getUserData(request.auth.uid).isKicked == false
      );
    }

    function isOptionalString(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isSafeMediaUrlString(val, maxLen) {
      return val is string &&
        val.size() <= maxLen &&
        (
          val.matches('^https://[^\\s<>"\']+$') ||
          val.matches('^data:image/(png|jpeg|jpg|webp|gif);base64,[A-Za-z0-9+/=]+$') ||
          val.matches('^\\.?/(src/)?assets/[A-Za-z0-9_./\\-]+$')
        );
    }

    function isSafeStoryMediaUrlString(val, maxLen) {
      return val is string &&
        val.size() <= maxLen &&
        (
          isSafeMediaUrlString(val, maxLen) ||
          val.matches('^data:video/(mp4|webm|quicktime);base64,[A-Za-z0-9+/=]+$')
        );
    }

    function isOptionalSafeMediaUrl(data, field, maxLen) {
      return !(field in data) || (
        data[field] is string &&
        (data[field] == '' || isSafeMediaUrlString(data[field], maxLen))
      );
    }

    function isOptionalTimestamp(data, field) {
      return !(field in data) || data[field] == null || data[field] is timestamp;
    }

    function isOptionalCountryCode(data) {
      return !('countryCode' in data) || (data.countryCode is string && data.countryCode.matches('^[A-Z]{2}$'));
    }

    function isAnyBarberOrAdmin() {
      return isSuperAdmin() || (
        isVerifiedEmail() &&
        userExists(request.auth.uid) &&
        getUserData(request.auth.uid).isBanned == false &&
        (
          userHasRole(getUserData(request.auth.uid), 'vip_barber') ||
          userHasRole(getUserData(request.auth.uid), 'master_barber') ||
          userHasRole(getUserData(request.auth.uid), 'barber_verified') ||
          hasDynamicRolePerm(getUserData(request.auth.uid), 'receiveBookings')
        )
      );
    }

    function canPublishStory() {
      return isSuperAdmin() || (
        isVerifiedEmail() &&
        userExists(request.auth.uid) &&
        getUserData(request.auth.uid).isBanned == false &&
        (
          ('canPostStory' in getUserData(request.auth.uid) && getUserData(request.auth.uid).canPostStory == true) ||
          hasDynamicRolePerm(getUserData(request.auth.uid), 'publishStories')
        )
      );
    }

    // Store Configuration Helpers (Server-Enforced Pricing & Availability)
    function hasStoreConfig() {
      return exists(/databases/$(database)/documents/storeConfig/current);
    }

    function getStoreConfigData() {
      return get(/databases/$(database)/documents/storeConfig/current).data;
    }

    function isStoreItemEnabled(itemKey) {
      return !hasStoreConfig() ||
        !('items' in getStoreConfigData()) ||
        !(itemKey in getStoreConfigData().items) ||
        getStoreConfigData().items[itemKey].enabled == true;
    }

    function getStoreItemPrice(itemKey, defaultPrice) {
      return hasStoreConfig() &&
        'items' in getStoreConfigData() &&
        itemKey in getStoreConfigData().items
        ? getStoreConfigData().items[itemKey].price
        : defaultPrice;
    }

    function getStoreItemDurationDays(itemKey) {
      return hasStoreConfig() &&
        'items' in getStoreConfigData() &&
        itemKey in getStoreConfigData().items
        ? getStoreConfigData().items[itemKey].durationDays
        : 7;
    }

    function isReservedHandle(handle) {
      return handle.size() <= 2 ||
        (hasStoreConfig() && 'reservedSpecialIds' in getStoreConfigData() && handle in getStoreConfigData().reservedSpecialIds);
    }

    function getDailyRewardCap() {
      return hasStoreConfig() && 'dailyRewardCoins' in getStoreConfigData()
        ? getStoreConfigData().dailyRewardCoins
        : 25;
    }

    // --- Validation Blueprints ---

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'role', 'availability',
          'isMuted', 'isKicked', 'isBanned', 'isPublicProfile',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'username', 'baseUsername',
          'isSpecialId', 'specialIdLabel', 'specialIdExpiresAt', 'specialIdGrantedBy',
          'nameColor', 'nameColorExpiresAt', 'avatarFrame', 'avatarFrameExpiresAt',
          'chatTitle', 'chatTitleExpiresAt',
          'creditPassTier', 'creditPassExpiresAt',
          'lastDailyClaimDate', 'photoURL', 'coverURL', 'bio',
          'role', 'roles', 'availability', 'liveStatus', 'points', 'completedBookingsCount',
          'salonName', 'addressLabel', 'location', 'services', 'canPostStory', 'countryCode',
          'friendRequestPolicy', 'hideOnlineStatus', 'isOnline', 'lastActiveAt',
          'isMuted', 'muteReason', 'isKicked', 'kickReason',
          'isBanned', 'banReason', 'isPublicProfile',
          'createdAt', 'updatedAt'
        ]) &&
        data.uid == userId &&
        isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        (!('username' in data) || (data.username is string && data.username.matches('^[a-z0-9_]{1,24}$'))) &&
        (!('baseUsername' in data) || (data.baseUsername is string && data.baseUsername.matches('^[a-z0-9_]{1,24}$'))) &&
        (!('isSpecialId' in data) || data.isSpecialId is bool) &&
        isOptionalString(data, 'specialIdLabel', 40) &&
        isOptionalTimestamp(data, 'specialIdExpiresAt') &&
        isOptionalString(data, 'specialIdGrantedBy', 40) &&
        isOptionalString(data, 'nameColor', 40) &&
        isOptionalTimestamp(data, 'nameColorExpiresAt') &&
        isOptionalString(data, 'avatarFrame', 40) &&
        isOptionalTimestamp(data, 'avatarFrameExpiresAt') &&
        isOptionalString(data, 'chatTitle', 40) &&
        isOptionalTimestamp(data, 'chatTitleExpiresAt') &&
        isOptionalString(data, 'creditPassTier', 40) &&
        isOptionalTimestamp(data, 'creditPassExpiresAt') &&
        (!('lastDailyClaimDate' in data) || (data.lastDailyClaimDate is string && data.lastDailyClaimDate.matches('^\\d{4}-\\d{2}-\\d{2}$'))) &&
        isOptionalSafeMediaUrl(data, 'photoURL', 350000) &&
        isOptionalSafeMediaUrl(data, 'coverURL', 350000) &&
        isOptionalString(data, 'bio', 400) &&
        isValidRoleId(data.role) &&
        (!('roles' in data) || (
          data.roles is list &&
          data.roles.size() >= 1 &&
          data.roles.size() <= 6 &&
          isValidRoleId(data.roles[0])
        )) &&
        data.availability in ['available', 'busy'] &&
        (!('liveStatus' in data) || data.liveStatus in ['online', 'cutting', 'offline']) &&
        (!('points' in data) || (data.points is int && data.points >= 0 && data.points <= 1000000)) &&
        (!('completedBookingsCount' in data) || (data.completedBookingsCount is int && data.completedBookingsCount >= 0 && data.completedBookingsCount <= 100000)) &&
        isOptionalString(data, 'salonName', 100) &&
        isOptionalString(data, 'addressLabel', 160) &&
        (!('location' in data) || (
          data.location is map &&
          data.location.keys().hasAll(['lat', 'lng']) &&
          data.location.keys().hasOnly(['lat', 'lng']) &&
          data.location.lat is number && data.location.lat >= -90 && data.location.lat <= 90 &&
          data.location.lng is number && data.location.lng >= -180 && data.location.lng <= 180
        )) &&
        (!('services' in data) || (
          data.services is list &&
          data.services.size() <= 20 &&
          (data.services.size() == 0 || (
            data.services[0] is map &&
            data.services[0].keys().hasAll(['id', 'name', 'price', 'durationMinutes'])
          ))
        )) &&
        (!('canPostStory' in data) || data.canPostStory is bool) &&
        isOptionalCountryCode(data) &&
        (!('friendRequestPolicy' in data) || data.friendRequestPolicy in ['everyone', 'barbers_only', 'nobody']) &&
        (!('hideOnlineStatus' in data) || data.hideOnlineStatus is bool) &&
        (!('isOnline' in data) || data.isOnline is bool) &&
        (!('lastActiveAt' in data) || data.lastActiveAt is timestamp) &&
        data.isMuted is bool &&
        isOptionalString(data, 'muteReason', 240) &&
data.isKicked is bool &&
        isOptionalString(data, 'kickReason', 240) &&
        data.isBanned is bool &&
        isOptionalString(data, 'banReason', 240) &&
        data.isPublicProfile == true &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.uid == userId &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBlockedUser(data, userId, blockedUid) {
      return data.keys().hasAll(['id', 'blockerId', 'blockedUserId', 'blockedUserName', 'createdAt']) &&
        data.keys().hasOnly(['id', 'blockerId', 'blockedUserId', 'blockedUserName', 'blockedUserPhoto', 'reason', 'createdAt']) &&
        data.id == blockedUid &&
        data.blockerId == userId &&
        data.blockedUserId == blockedUid &&
        isValidId(data.id) &&
        isValidId(data.blockerId) &&
        isValidId(data.blockedUserId) &&
        data.blockerId != data.blockedUserId &&
        data.blockedUserName is string && data.blockedUserName.size() >= 1 && data.blockedUserName.size() <= 80 &&
        isOptionalSafeMediaUrl(data, 'blockedUserPhoto', 350000) &&
        isOptionalString(data, 'reason', 240) &&
        data.createdAt is timestamp;
    }

    function isValidContentReport(data, reportId) {
      return data.keys().hasAll([
          'id', 'reporterId', 'reporterName', 'targetType', 'targetId',
          'targetOwnerId', 'targetOwnerName', 'category', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'reporterId', 'reporterName', 'targetType', 'targetId',
          'targetOwnerId', 'targetOwnerName', 'targetPreview', 'category',
          'reason', 'status', 'reviewedById', 'reviewedByName', 'resolutionNote',
          'createdAt', 'updatedAt'
        ]) &&
        data.id == reportId &&
        isValidId(data.id) &&
        isValidId(data.reporterId) &&
        data.reporterName is string && data.reporterName.size() >= 1 && data.reporterName.size() <= 80 &&
        data.targetType in ['message', 'gallery', 'story', 'profile'] &&
        isValidId(data.targetId) &&
        isValidId(data.targetOwnerId) &&
        data.targetOwnerName is string && data.targetOwnerName.size() >= 1 && data.targetOwnerName.size() <= 80 &&
        isOptionalString(data, 'targetPreview', 180) &&
        data.category in ['harassment', 'spam', 'inappropriate', 'impersonation', 'other'] &&
        isOptionalString(data, 'reason', 400) &&
        data.status in ['pending', 'reviewed', 'dismissed'] &&
        isOptionalString(data, 'reviewedById', 128) &&
        isOptionalString(data, 'reviewedByName', 80) &&
        isOptionalString(data, 'resolutionNote', 300) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidRoleDefinition(data, roleId) {
      return data.keys().hasAll([
          'id', 'nameAr', 'shortLabelAr', 'colorKey',
          'hierarchyOrder', 'permissions', 'createdById', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'nameAr', 'shortLabelAr', 'descriptionAr', 'colorKey',
          'hierarchyOrder', 'isSystem', 'permissions', 'createdById', 'createdAt', 'updatedAt'
        ]) &&
        data.id == roleId &&
        isValidRoleId(data.id) &&
        data.nameAr is string && data.nameAr.size() >= 1 && data.nameAr.size() <= 60 &&
        data.shortLabelAr is string && data.shortLabelAr.size() >= 1 && data.shortLabelAr.size() <= 40 &&
        isOptionalString(data, 'descriptionAr', 240) &&
        data.colorKey in ['gold', 'crimson', 'indigo', 'teal', 'silver', 'amber', 'emerald', 'violet', 'slate'] &&
        data.hierarchyOrder is int && data.hierarchyOrder >= 1 && data.hierarchyOrder <= 100 &&
        (!('isSystem' in data) || data.isSystem is bool) &&
        data.permissions is map &&
        isValidId(data.createdById) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStoreItemConfig(item) {
      return item is map &&
        item.keys().hasAll(['enabled', 'price', 'durationDays']) &&
        item.keys().hasOnly(['enabled', 'price', 'durationDays', 'labelAr']) &&
        item.enabled is bool &&
        item.price is int && item.price >= 0 && item.price <= 100000 &&
        item.durationDays is int && item.durationDays >= 1 && item.durationDays <= 365 &&
        isOptionalString(item, 'labelAr', 80);
    }

    function isValidStoreConfig(data, configId) {
      return data.keys().hasAll([
          'id', 'dailyRewardCoins', 'reservedSpecialIds', 'items',
          'updatedById', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'dailyRewardCoins', 'reservedSpecialIds', 'items',
          'updatedById', 'createdAt', 'updatedAt'
        ]) &&
        data.id == configId &&
        configId == 'current' &&
        data.dailyRewardCoins is int && data.dailyRewardCoins >= 0 && data.dailyRewardCoins <= 100 &&
        data.reservedSpecialIds is list && data.reservedSpecialIds.size() <= 100 &&
        data.items is map &&
        data.items.keys().hasAll(['special_id', 'name_color', 'avatar_frame']) &&
        data.items.keys().hasOnly(['special_id', 'name_color', 'avatar_frame', 'chat_title', 'credit_pass']) &&
        isValidStoreItemConfig(data.items.special_id) &&
        isValidStoreItemConfig(data.items.name_color) &&
        isValidStoreItemConfig(data.items.avatar_frame) &&
        (!('chat_title' in data.items) || isValidStoreItemConfig(data.items.chat_title)) &&
        (!('credit_pass' in data.items) || isValidStoreItemConfig(data.items.credit_pass)) &&
        isValidId(data.updatedById) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidVerificationRequest(data, requestId) {
      return data.keys().hasAll([
          'id', 'userId', 'userName', 'salonName', 'experience',
          'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'userName', 'userPhoto', 'salonName',
          'countryCode', 'city', 'experience', 'phoneOrSocial', 'status', 'adminNote',
          'createdAt', 'updatedAt'
        ]) &&
        data.id == requestId &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
        isOptionalSafeMediaUrl(data, 'userPhoto', 350000) &&
        data.salonName is string && data.salonName.size() >= 1 && data.salonName.size() <= 100 &&
        isOptionalCountryCode(data) &&
        isOptionalString(data, 'city', 80) &&
        data.experience is string && data.experience.size() >= 1 && data.experience.size() <= 400 &&
        isOptionalString(data, 'phoneOrSocial', 120) &&
        data.status in ['pending', 'approved', 'rejected'] &&
        isOptionalString(data, 'adminNote', 300) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidGalleryItem(data, itemId) {
      return data.keys().hasAll([
          'id', 'barberId', 'barberName', 'title', 'category',
          'imageUrl', 'visibility', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'barberId', 'barberName', 'barberPhoto', 'title',
          'description', 'category', 'imageUrl', 'isBeforeAfter',
          'beforeImageUrl', 'countryCode',
          'visibility', 'createdAt', 'updatedAt'
        ]) &&
        data.id == itemId &&
        isValidId(data.id) &&
        isValidId(data.barberId) &&
        data.barberName is string && data.barberName.size() >= 1 && data.barberName.size() <= 80 &&
        isOptionalSafeMediaUrl(data, 'barberPhoto', 350000) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
        isOptionalString(data, 'description', 500) &&
        data.category in ['fade', 'beard', 'classic', 'styling', 'vip'] &&
        isSafeMediaUrlString(data.imageUrl, 400000) &&
        data.imageUrl.size() >= 1 &&
        (!('isBeforeAfter' in data) || data.isBeforeAfter is bool) &&
        isOptionalSafeMediaUrl(data, 'beforeImageUrl', 400000) &&
        isOptionalCountryCode(data) &&
        data.visibility == 'public' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLikeRecord(data, likeId) {
      return data.keys().hasAll(['id', 'targetType', 'targetId', 'userId', 'createdAt']) &&
        data.keys().hasOnly(['id', 'targetType', 'targetId', 'userId', 'createdAt']) &&
        data.id == likeId &&
        isValidId(data.id) &&
        data.targetType in ['profile', 'gallery'] &&
        isValidId(data.targetId) &&
        isValidId(data.userId) &&
        data.createdAt is timestamp;
    }

    function isValidSupportTicket(data, ticketId) {
      return data.keys().hasAll([
          'id', 'userId', 'userName', 'userRole', 'subject',
          'category', 'description', 'status', 'lastMessage',
          'lastMessageAt', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'userName', 'userPhoto', 'userRole',
          'subject', 'category', 'description', 'status',
          'assignedModeratorId', 'assignedModeratorName',
          'resolutionNote', 'lastMessage', 'lastMessageAt',
          'createdAt', 'updatedAt'
        ]) &&
        data.id == ticketId &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
        isOptionalSafeMediaUrl(data, 'userPhoto', 350000) &&
        isValidRoleId(data.userRole) &&
        data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 140 &&
        data.category in ['complaint', 'report_user', 'technical', 'inquiry'] &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 1500 &&
        data.status in ['open', 'in_progress', 'closed'] &&
        isOptionalString(data, 'assignedModeratorId', 128) &&
        isOptionalString(data, 'assignedModeratorName', 80) &&
        isOptionalString(data, 'resolutionNote', 400) &&
        data.lastMessage is string && data.lastMessage.size() <= 300 &&
        data.lastMessageAt is timestamp &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSupportTicketMessage(data, ticketId, messageId) {
      return data.keys().hasAll([
          'id', 'ticketId', 'ticketOwnerId', 'senderId',
          'senderName', 'senderRole', 'text', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ticketId', 'ticketOwnerId', 'senderId',
          'senderName', 'senderPhoto', 'senderRole', 'text', 'createdAt'
        ]) &&
        data.id == messageId &&
        data.ticketId == ticketId &&
        isValidId(data.id) &&
        isValidId(data.ticketId) &&
        isValidId(data.ticketOwnerId) &&
        isValidId(data.senderId) &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
        isOptionalSafeMediaUrl(data, 'senderPhoto', 350000) &&
        isValidRoleId(data.senderRole) &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 1200 &&
        data.createdAt is timestamp;
    }

    function isValidCommunityMessage(data, messageId) {
      return data.keys().hasAll([
          'id', 'senderId', 'senderName', 'senderRole', 'text',
          'edited', 'visibility', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'senderId', 'senderName', 'senderUsername', 'senderPhoto', 'senderRole',
          'text', 'replyToId', 'replyToSenderId', 'replyToSenderName',
          'replyToSenderUsername', 'replyToText', 'mentions',
          'edited', 'roomType', 'countryCode', 'visibility', 'createdAt', 'updatedAt'
        ]) &&
        data.id == messageId &&
        isValidId(data.id) &&
        isValidId(data.senderId) &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
        (!('senderUsername' in data) || (data.senderUsername is string && data.senderUsername.matches('^[a-z0-9_]{1,24}$'))) &&
        isOptionalSafeMediaUrl(data, 'senderPhoto', 350000) &&
        isValidRoleId(data.senderRole) &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 1000 &&
        (!('replyToId' in data) || isValidId(data.replyToId)) &&
        (!('replyToSenderId' in data) || isValidId(data.replyToSenderId)) &&
        isOptionalString(data, 'replyToSenderName', 80) &&
        isOptionalString(data, 'replyToSenderUsername', 24) &&
        isOptionalString(data, 'replyToText', 200) &&
        (!('mentions' in data) || (
          data.mentions is list &&
          data.mentions.size() <= 10 &&
          (data.mentions.size() == 0 || isValidId(data.mentions[0]))
        )) &&
        data.edited is bool &&
        (!('roomType' in data) || data.roomType in ['global', 'local']) &&
        isOptionalCountryCode(data) &&
        data.visibility == 'public' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStaffMessage(data, messageId) {
      return data.keys().hasAll([
          'id', 'senderId', 'senderName', 'senderRole', 'text',
          'edited', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'senderId', 'senderName', 'senderPhoto', 'senderRole',
          'text', 'edited', 'createdAt', 'updatedAt'
        ]) &&
        data.id == messageId &&
        isValidId(data.id) &&
        isValidId(data.senderId) &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
        isOptionalSafeMediaUrl(data, 'senderPhoto', 350000) &&
        isValidRoleId(data.senderRole) &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 1200 &&
        data.edited is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStaffGuideline(data, guidelineId) {
      return data.keys().hasAll([
          'id', 'authorId', 'authorName', 'title', 'category',
          'content', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'authorId', 'authorName', 'title', 'category',
          'content', 'createdAt', 'updatedAt'
]) &&
        data.id == guidelineId &&
        isValidId(data.id) &&
        isValidId(data.authorId) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.category in ['duties', 'rules', 'tickets', 'escalation'] &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 2000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProfilePost(data, postId) {
      return data.keys().hasAll([
          'id', 'authorId', 'authorName', 'authorRole', 'text',
          'visibility', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'authorId', 'authorName', 'authorPhoto', 'authorRole',
          'text', 'imageUrl', 'visibility', 'createdAt', 'updatedAt'
        ]) &&
        data.id == postId &&
        isValidId(data.id) &&
        isValidId(data.authorId) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
        isOptionalSafeMediaUrl(data, 'authorPhoto', 350000) &&
        isValidRoleId(data.authorRole) &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 1200 &&
        isOptionalSafeMediaUrl(data, 'imageUrl', 450000) &&
        data.visibility == 'public' &&
        data.createdAt is timestamp &&
