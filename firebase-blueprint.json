{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public profile, live status, Aurelius Credits, temporary Store perks, and dynamic role state for a platform member.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "username": { "type": "string", "minLength": 1, "maxLength": 24, "pattern": "^[a-z0-9_]{1,24}$" },
        "baseUsername": { "type": "string", "minLength": 1, "maxLength": 24, "pattern": "^[a-z0-9_]{1,24}$" },
        "isSpecialId": { "type": "boolean" },
        "specialIdLabel": { "type": "string", "maxLength": 40 },
        "specialIdExpiresAt": { "type": "string", "format": "date-time" },
        "specialIdGrantedBy": { "type": "string", "maxLength": 40 },
        "nameColor": { "type": "string", "maxLength": 40 },
        "nameColorExpiresAt": { "type": "string", "format": "date-time" },
        "avatarFrame": { "type": "string", "maxLength": 40 },
        "avatarFrameExpiresAt": { "type": "string", "format": "date-time" },
        "chatTitle": { "type": "string", "maxLength": 40 },
        "chatTitleExpiresAt": { "type": "string", "format": "date-time" },
        "creditPassTier": { "type": "string", "maxLength": 40 },
        "creditPassExpiresAt": { "type": "string", "format": "date-time" },
        "lastDailyClaimDate": { "type": "string", "maxLength": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "photoURL": { "type": "string", "maxLength": 350000 },
        "coverURL": { "type": "string", "maxLength": 350000 },
        "bio": { "type": "string", "maxLength": 400 },
        "role": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]{1,64}$" },
        "roles": { "type": "array", "description": "Optional multi-role array assigned manually by Super Admin." },
        "availability": { "type": "string", "enum": ["available", "busy"] },
        "liveStatus": { "type": "string", "enum": ["online", "cutting", "offline"] },
        "points": { "type": "integer", "description": "Aurelius Credits balance earned from daily login, chat, engagement, bookings, and admin grants." },
        "completedBookingsCount": { "type": "integer", "description": "Count of completed barber appointments." },
        "salonName": { "type": "string", "maxLength": 100 },
        "addressLabel": { "type": "string", "maxLength": 160 },
        "location": { "type": "object" },
        "services": { "type": "array" },
        "canPostStory": { "type": "boolean", "description": "Manual permission granted by Super Admin to publish 24h Aurelius Stories." },
        "countryCode": { "type": "string", "minLength": 2, "maxLength": 2, "pattern": "^[A-Z]{2}$" },
        "friendRequestPolicy": { "type": "string", "enum": ["everyone", "barbers_only", "nobody"] },
        "hideOnlineStatus": { "type": "boolean" },
        "isOnline": { "type": "boolean" },
        "lastActiveAt": { "type": "string", "format": "date-time" },
        "isMuted": { "type": "boolean" },
        "muteReason": { "type": "string", "maxLength": 240 },
        "isKicked": { "type": "boolean" },
        "kickReason": { "type": "string", "maxLength": 240 },
        "isBanned": { "type": "boolean" },
        "banReason": { "type": "string", "maxLength": 240 },
        "isPublicProfile": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "role", "availability", "isMuted", "isKicked", "isBanned", "isPublicProfile", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
